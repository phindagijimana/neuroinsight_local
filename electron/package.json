{
  "name": "neuroinsight-autohs-desktop",
  "version": "1.1.0",
  "description": "NeuroInsight-AutoHS desktop app (Docker all-in-one)",
  "main": "src/main.js",
  "author": "NeuroInsight-AutoHS",
  "license": "MIT",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --mac --linux --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.neuroinsight.autohs.desktop",
    "productName": "NeuroInsight-AutoHS",
    "copyright": "Copyright © 2026 NeuroInsight-AutoHS",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "renderer/logo.svg",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../deploy/entrypoint.sh",
        "to": "entrypoint.sh"
      }
    ],
    "mac": {
      "category": "public.app-category.medical",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Science",
      "maintainer": "NeuroInsight-AutoHS <support@neuroinsight.local>"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NeuroInsight-AutoHS"
    },
    "dmg": {
      "title": "NeuroInsight-AutoHS ${version}"
    }
  }
}
