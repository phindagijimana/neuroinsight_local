#!/bin/bash
# NeuroInsight-AutoHS Docker Management CLI
# Equivalent to ./neuroinsight-autohs but for Docker deployment

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
CONTAINER_NAME="neuroinsight-autohs"
IMAGE_NAME="phindagijimana321/neuroinsight-autohs:latest"
FREESURFER_IMAGE="${FREESURFER_IMAGE:-freesurfer/freesurfer:7.4.1}"
VOLUME_NAME="neuroinsight-autohs-data"
MIN_DISK_GB="${NEUROINSIGHT_MIN_DISK_GB:-50}"
MIN_RAM_GB="${NEUROINSIGHT_MIN_RAM_GB:-16}"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Check if Docker is installed and the daemon is reachable
check_docker() {
    if ! command -v docker &> /dev/null; then
        log_error "Docker is not installed."
        echo "Please install Docker first:"
        echo "  Linux:   https://docs.docker.com/engine/install/"
        echo "  macOS:   https://www.docker.com/products/docker-desktop/"
        exit 1
    fi
    if ! docker info >/dev/null 2>&1; then
        log_error "Docker is installed but the daemon is not running."
        echo "Start Docker Desktop (macOS/Windows) or run: sudo systemctl start docker"
        exit 1
    fi
}

# Optional platform flag for Apple Silicon / arm64 hosts (published image is linux/amd64)
docker_platform_args() {
    local arch
    arch="$(uname -m 2>/dev/null || echo unknown)"
    if [ "$arch" = "arm64" ] || [ "$arch" = "aarch64" ]; then
        echo "--platform linux/amd64"
    fi
}

# Warn if the host may be under-resourced (non-fatal)
preflight_resources() {
    if command -v df >/dev/null 2>&1; then
        local free_gb
        free_gb="$(df -g . 2>/dev/null | awk 'NR==2 {print $4}' || df -BG . 2>/dev/null | awk 'NR==2 {gsub(/G/,""); print $4}')"
        if [ -n "$free_gb" ] && [ "$free_gb" -lt "$MIN_DISK_GB" ] 2>/dev/null; then
            log_warning "Low disk space: ${free_gb}GB free (recommend ${MIN_DISK_GB}GB+)"
        fi
    fi
    if command -v sysctl >/dev/null 2>&1; then
        local mem_bytes mem_gb
        mem_bytes="$(sysctl -n hw.memsize 2>/dev/null || echo 0)"
        if [ "$mem_bytes" -gt 0 ] 2>/dev/null; then
            mem_gb=$((mem_bytes / 1024 / 1024 / 1024))
            if [ "$mem_gb" -lt "$MIN_RAM_GB" ]; then
                log_warning "Low RAM: ${mem_gb}GB (recommend ${MIN_RAM_GB}GB+ for MRI processing)"
            fi
        fi
    elif [ -r /proc/meminfo ]; then
        local mem_gb
        mem_gb="$(awk '/MemTotal/ {printf "%.0f", $2/1024/1024}' /proc/meminfo)"
        if [ -n "$mem_gb" ] && [ "$mem_gb" -lt "$MIN_RAM_GB" ] 2>/dev/null; then
            log_warning "Low RAM: ${mem_gb}GB (recommend ${MIN_RAM_GB}GB+ for MRI processing)"
        fi
    fi
}

# Find FreeSurfer license.txt on the host (only manual step for the user)
find_license_path() {
    local candidate
    for candidate in \
        "${SCRIPT_DIR}/license.txt" \
        "${SCRIPT_DIR}/../license.txt" \
        "${SCRIPT_DIR}/../../license.txt" \
        "${HOME}/Documents/license.txt" \
        "${HOME}/license.txt"
    do
        if [ -f "$candidate" ]; then
            echo "$candidate"
            return 0
        fi
    done
    return 1
}

license_is_example() {
    local path="$1"
    grep -q "REPLACE THIS EXAMPLE CONTENT" "$path" 2>/dev/null || \
        grep -q "FreeSurfer License File - EXAMPLE" "$path" 2>/dev/null
}

# Shared guidance when license.txt is missing or invalid
print_license_help() {
    local reason="${1:-not found}"
    echo "FreeSurfer license.txt ${reason}."
    echo ""
    echo "This is the only manual setup step. Place your license file here (recommended):"
    echo "  ${PROJECT_ROOT}/license.txt"
    echo ""
    echo "Other accepted locations:"
    echo "  ${HOME}/Documents/license.txt"
    echo "  ${HOME}/license.txt"
    echo ""
    echo "Get a free research license (required for MRI processing):"
    echo "  https://surfer.nmr.mgh.harvard.edu/registration.html"
    echo ""
    echo "After adding the license, run:"
    echo "  ./neuroinsight-autohs-docker setup"
}

# Check license status; prints help and returns 1 if not usable
check_license_ready() {
    local license_path=""
    if ! license_path="$(find_license_path)"; then
        print_license_help "not found"
        return 1
    fi
    if license_is_example "$license_path"; then
        echo "Found license file but it contains example content (not valid):"
        echo "  ${license_path}"
        echo ""
        print_license_help "is invalid"
        return 1
    fi
    return 0
}

# Verify all install prerequisites; report every missing item before exiting
# Pass --verbose to print each check step (used by ./neuroinsight-autohs-docker check)
preflight_install() {
    local show_steps=false
    if [ "${1:-}" = "--verbose" ] || [ "${1:-}" = "-v" ]; then
        show_steps=true
    fi

    local -a blockers=()
    local -a fixes=()
    local -a warnings=()
    local total_steps=9
    local step=0

    preflight_step_begin() {
        step=$((step + 1))
        if [ "$show_steps" = true ]; then
            echo ""
            echo -e "${BLUE}[${step}/${total_steps}]${NC} $1..."
        fi
    }

    preflight_step_ok() {
        if [ "$show_steps" = true ]; then
            echo -e "      ${GREEN}OK${NC}  $1"
        fi
    }

    preflight_step_fail() {
        if [ "$show_steps" = true ]; then
            echo -e "      ${RED}FAIL${NC}  $1"
        fi
    }

    preflight_step_warn() {
        if [ "$show_steps" = true ]; then
            echo -e "      ${YELLOW}WARN${NC}  $1"
        fi
    }

    if [ "$show_steps" = true ]; then
        echo ""
        log_info "Project: ${PROJECT_ROOT}"
        log_info "Running ${total_steps} setup checks..."
    fi

    preflight_step_begin "Checking Docker installation"
    if ! command -v docker &>/dev/null; then
        preflight_step_fail "Docker CLI not found"
        blockers+=("Docker is not installed")
        fixes+=("Install Docker, then re-run ./neuroinsight-autohs-docker setup
  Linux:   https://docs.docker.com/engine/install/
  macOS:   https://www.docker.com/products/docker-desktop/
  Windows: https://www.docker.com/products/docker-desktop/")
    else
        preflight_step_ok "Docker CLI found ($(command -v docker))"
    fi

    preflight_step_begin "Checking Docker daemon"
    if command -v docker &>/dev/null && docker info >/dev/null 2>&1; then
        preflight_step_ok "Docker daemon is running"
    elif command -v docker &>/dev/null; then
        preflight_step_fail "Docker daemon is not running"
        blockers+=("Docker is installed but the daemon is not running")
        fixes+=("Start Docker Desktop (macOS/Windows) or run:
  sudo systemctl start docker
Then re-run: ./neuroinsight-autohs-docker setup")
    else
        preflight_step_fail "Skipped (Docker not installed)"
    fi

    preflight_step_begin "Checking FreeSurfer license.txt"
    local license_path=""
    if ! license_path="$(find_license_path)"; then
        preflight_step_fail "license.txt not found"
        blockers+=("FreeSurfer license.txt not found")
        fixes+=("Place your license in the neuroinsight_local folder (recommended):
  ${PROJECT_ROOT}/license.txt

Other accepted locations:
  ${HOME}/Documents/license.txt
  ${HOME}/license.txt

Get a free research license:
  https://surfer.nmr.mgh.harvard.edu/registration.html")
    elif license_is_example "$license_path"; then
        preflight_step_fail "license.txt is example content (not valid)"
        blockers+=("FreeSurfer license.txt is example content (not valid)")
        fixes+=("Replace the example file with your real license:
  ${license_path}

Or place a valid license at:
  ${PROJECT_ROOT}/license.txt

Get a free research license:
  https://surfer.nmr.mgh.harvard.edu/registration.html")
    else
        preflight_step_ok "Valid license found at ${license_path}"
    fi

    preflight_step_begin "Checking web UI port (8000-8050)"
    local web_port=""
    web_port="$(find_available_port 2>/dev/null || true)"
    if [ -z "$web_port" ]; then
        preflight_step_fail "No free port in range 8000-8050"
        blockers+=("No free port for web UI (range 8000-8050)")
        fixes+=("Stop other services using ports 8000-8050, then re-run:
  ./neuroinsight-autohs-docker setup")
    else
        preflight_step_ok "Port ${web_port} available for web UI"
    fi

    preflight_step_begin "Checking MinIO ports (9000-9050)"
    local minio_api_port minio_console_port
    minio_api_port="$(find_available_port_in_range 9000 9050 2>/dev/null || true)"
    minio_console_port=""
    if [ -n "$minio_api_port" ]; then
        minio_console_port="$(find_available_port_in_range 9000 9050 "$minio_api_port" 2>/dev/null || true)"
    fi
    if [ -z "$minio_api_port" ] || [ -z "$minio_console_port" ]; then
        preflight_step_fail "Need two free ports in range 9000-9050"
        blockers+=("No free ports for MinIO (range 9000-9050)")
        fixes+=("Stop other services using ports 9000-9050, then re-run:
  ./neuroinsight-autohs-docker setup")
    else
        preflight_step_ok "Ports ${minio_api_port} (API) and ${minio_console_port} (console) available"
    fi

    preflight_step_begin "Checking macOS Docker Desktop entrypoint fix"
    if [ -f "${SCRIPT_DIR}/entrypoint.sh" ]; then
        preflight_step_ok "deploy/entrypoint.sh present (will mount on install)"
    else
        preflight_step_warn "deploy/entrypoint.sh missing — macOS Docker Desktop may fail"
        warnings+=("deploy/entrypoint.sh missing — macOS Docker Desktop installs may fail")
    fi

    preflight_step_begin "Checking curl (UI readiness wait)"
    if command -v curl &>/dev/null; then
        preflight_step_ok "curl found"
    else
        preflight_step_warn "curl not installed — install will continue but UI wait may be skipped"
        warnings+=("curl not installed — install will continue but UI readiness check may be skipped")
    fi

    preflight_step_begin "Checking disk space"
    if command -v df >/dev/null 2>&1; then
        local free_gb
        free_gb="$(df -g . 2>/dev/null | awk 'NR==2 {print $4}' || df -BG . 2>/dev/null | awk 'NR==2 {gsub(/G/,""); print $4}')"
        if [ -n "$free_gb" ] && [ "$free_gb" -lt "$MIN_DISK_GB" ] 2>/dev/null; then
            preflight_step_warn "${free_gb}GB free (recommend ${MIN_DISK_GB}GB+ for MRI data)"
            warnings+=("Low disk space: ${free_gb}GB free (recommend ${MIN_DISK_GB}GB+ for MRI data)")
        elif [ -n "$free_gb" ]; then
            preflight_step_ok "${free_gb}GB free disk space"
        else
            preflight_step_ok "Disk space check skipped"
        fi
    else
        preflight_step_ok "df not available — disk check skipped"
    fi

    preflight_step_begin "Checking system memory"
    local mem_gb=""
    if command -v sysctl >/dev/null 2>&1; then
        local mem_bytes
        mem_bytes="$(sysctl -n hw.memsize 2>/dev/null || echo 0)"
        if [ "$mem_bytes" -gt 0 ] 2>/dev/null; then
            mem_gb=$((mem_bytes / 1024 / 1024 / 1024))
        fi
    elif [ -r /proc/meminfo ]; then
        mem_gb="$(awk '/MemTotal/ {printf "%.0f", $2/1024/1024}' /proc/meminfo)"
    fi
    if [ -n "$mem_gb" ] && [ "$mem_gb" -lt "$MIN_RAM_GB" ] 2>/dev/null; then
        preflight_step_warn "${mem_gb}GB RAM (recommend ${MIN_RAM_GB}GB+ for MRI processing)"
        warnings+=("Low RAM: ${mem_gb}GB (recommend ${MIN_RAM_GB}GB+ for MRI processing)")
    elif [ -n "$mem_gb" ]; then
        preflight_step_ok "${mem_gb}GB RAM"
    else
        preflight_step_ok "Memory check skipped"
    fi

    if [ "$show_steps" = true ]; then
        echo ""
        echo "======================================"
        if [ "${#blockers[@]}" -eq 0 ]; then
            echo "Check complete — all required items OK"
        else
            echo "Check complete — ${#blockers[@]} required item(s) need attention"
        fi
        echo "======================================"
    fi

    if [ "${#blockers[@]}" -eq 0 ]; then
        if [ "$show_steps" != true ] && [ "${#warnings[@]}" -gt 0 ]; then
            for w in "${warnings[@]}"; do
                log_warning "$w"
            done
        fi
        return 0
    fi

    if [ "$show_steps" != true ]; then
        echo ""
        echo "======================================"
        echo "Setup requirements not met"
        echo "======================================"
    fi
    echo ""
    echo "Fix the items below, then re-run:"
    if [ "$show_steps" = true ]; then
        echo "  ./neuroinsight-autohs-docker check"
        echo "  ./neuroinsight-autohs-docker setup"
    else
        echo "  ./neuroinsight-autohs-docker setup"
    fi
    echo ""

    local i
    for i in "${!blockers[@]}"; do
        log_error "${blockers[$i]}"
        echo ""
        echo "${fixes[$i]}"
        echo ""
    done

    if [ "${#warnings[@]}" -gt 0 ]; then
        echo "Warnings (non-blocking):"
        for w in "${warnings[@]}"; do
            log_warning "$w"
        done
        echo ""
    fi

    exit 1
}

# Pull application and processing images
pull_required_images() {
    local platform_args
    platform_args="$(docker_platform_args)"
    # shellcheck disable=SC2086
    log_info "Pulling application image: ${IMAGE_NAME}..."
    docker pull ${platform_args} "${IMAGE_NAME}"
    log_info "Pulling FreeSurfer image: ${FREESURFER_IMAGE} (first install; large download)..."
    docker pull ${platform_args} "${FREESURFER_IMAGE}" || \
        log_warning "FreeSurfer image pull failed — will retry when a job starts"
}

# Wait until the web UI responds
wait_for_web_ready() {
    local port="$1"
    local attempts="${2:-60}"
    local i=1
    log_info "Waiting for NeuroInsight-AutoHS web UI on port ${port}..."
    while [ "$i" -le "$attempts" ]; do
        if curl -sf "http://localhost:${port}/" >/dev/null 2>&1; then
            log_success "Web UI is ready (http://localhost:${port})"
            return 0
        fi
        if ! container_running; then
            log_error "Container stopped while starting — check: ./neuroinsight-autohs-docker logs container"
            return 1
        fi
        sleep 5
        i=$((i + 1))
    done
    log_warning "Web UI did not respond in time — check: ./neuroinsight-autohs-docker status"
    return 1
}

# Mount patched entrypoint from this repo until Hub image includes macOS Docker Desktop fix
entrypoint_mount_args() {
    if [ -f "${SCRIPT_DIR}/entrypoint.sh" ]; then
        echo "-v ${SCRIPT_DIR}/entrypoint.sh:/app/entrypoint.sh:ro"
    fi
}

# Check if container exists
container_exists() {
    docker ps -a --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"
}

# Check if container is running
container_running() {
    docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"
}

# Check if a port is available
port_available() {
    local port=$1
    
    # Method 1: Check with lsof (if available)
    if command -v lsof &> /dev/null; then
        if lsof -i:${port} -sTCP:LISTEN -t >/dev/null 2>&1; then
            return 1  # Port is in use
        fi
    fi
    
    # Method 2: Check with ss (modern, preferred)
    if command -v ss &> /dev/null; then
        if ss -tln 2>/dev/null | grep -q ":${port}\b"; then
            return 1  # Port is in use
        fi
    fi
    
    # Method 3: Check with netstat (fallback)
    if command -v netstat &> /dev/null; then
        if netstat -tln 2>/dev/null | grep -q ":${port}\b"; then
            return 1  # Port is in use
        fi
    fi
    
    # Method 4: Check Docker port mappings (critical for WSL/Docker Desktop)
    if command -v docker &> /dev/null; then
        # Check if any container is using this port
        if docker ps --format '{{.Ports}}' 2>/dev/null | grep -q "0.0.0.0:${port}->"; then
            return 1  # Port is in use by Docker
        fi
    fi
    
    # Method 5: Try to bind to the port (most reliable)
    # This will fail if port is in use, even if other methods miss it
    if command -v nc &> /dev/null; then
        # Try to bind using nc (netcat)
        if timeout 0.1 nc -l -p ${port} >/dev/null 2>&1; then
            # Successfully bound, port is available
            return 0
        else
            # Check if timeout worked (nc might not support -l -p on all systems)
            # Just skip this check if nc doesn't support it
            :
        fi
    fi
    
    # If we get here and haven't detected the port as in use, assume it's available
    return 0
}

# Find available port in range 8000-8050
find_available_port() {
    for port in {8000..8050}; do
        if port_available $port; then
            echo $port
            return 0
        fi
    done
    return 1
}

# Find available port in a custom range
find_available_port_in_range() {
    local start=$1
    local end=$2
    local exclude_port=$3  # Optional: port to exclude from search
    
    for port in $(seq $start $end); do
        if [ -n "$exclude_port" ] && [ "$port" -eq "$exclude_port" ]; then
            continue  # Skip excluded port
        fi
        if port_available $port; then
            echo $port
            return 0
        fi
    done
    return 1
}

# Get the port the container is using
get_container_port() {
    if container_exists; then
        docker port ${CONTAINER_NAME} 8000 2>/dev/null | cut -d':' -f2
    fi
}

# Get the MinIO API port the container is using
get_container_minio_api_port() {
    if container_exists; then
        docker port ${CONTAINER_NAME} 9000 2>/dev/null | cut -d':' -f2
    fi
}

# Get the MinIO Console port the container is using
get_container_minio_console_port() {
    if container_exists; then
        docker port ${CONTAINER_NAME} 9001 2>/dev/null | cut -d':' -f2
    fi
}

# Start container
cmd_start() {
    check_docker
    
    if container_running; then
        log_warning "NeuroInsight-AutoHS container is already running"
        local port=$(get_container_port)
        local minio_api=$(get_container_minio_api_port)
        local minio_console=$(get_container_minio_console_port)
        if [ -n "$port" ]; then
            echo "Web Interface: http://localhost:${port}"
        fi
        if [ -n "$minio_api" ]; then
            echo "MinIO API: http://localhost:${minio_api}"
        fi
        if [ -n "$minio_console" ]; then
            echo "MinIO Console: http://localhost:${minio_console}"
        fi
        cmd_status
        return 0
    fi
    
    if container_exists; then
        log_info "Starting existing container..."
        docker start ${CONTAINER_NAME}
        sleep 3
        log_success "Container started"

        local port
        port=$(get_container_port)
        if [ -n "$port" ]; then
            wait_for_web_ready "$port" 24 || true
        fi

        local minio_api minio_console
        minio_api=$(get_container_minio_api_port)
        minio_console=$(get_container_minio_console_port)
        
        echo ""
        log_success "NeuroInsight-AutoHS is ready!"
        if [ -n "$port" ]; then
            echo "Web Interface: http://localhost:${port}"
        fi
        if [ -n "$minio_api" ]; then
            echo "MinIO API: http://localhost:${minio_api}"
        fi
        if [ -n "$minio_console" ]; then
            echo "MinIO Console: http://localhost:${minio_console}"
        fi
    else
        log_error "Container does not exist."
        echo ""
        if ! check_license_ready; then
            :
        else
            echo "License is ready. Run:"
            echo "  ./neuroinsight-autohs-docker setup"
        fi
        exit 1
    fi
    
    echo ""
    cmd_status
}

# Stop container
cmd_stop() {
    check_docker
    
    if ! container_running; then
        log_warning "Container is not running"
        return 0
    fi
    
    log_info "Stopping NeuroInsight-AutoHS container..."
    docker stop ${CONTAINER_NAME}
    log_success "Container stopped"
}

# Restart container
cmd_restart() {
    cmd_stop
    sleep 2
    cmd_start
}

# Show status
cmd_status() {
    check_docker
    
    echo "======================================"
    echo "NeuroInsight-AutoHS Docker Status"
    echo "======================================"
    echo ""
    
    if ! container_exists; then
        log_error "Container does not exist"
        echo "Run: ./neuroinsight-autohs-docker install"
        return 1
    fi
    
    if container_running; then
        log_success "Container is running"
        echo ""
        
        # Get all ports
        local port=$(get_container_port)
        local minio_api=$(get_container_minio_api_port)
        local minio_console=$(get_container_minio_console_port)
        
        if [ -n "$port" ]; then
            echo "Web Interface: http://localhost:${port}"
        fi
        if [ -n "$minio_api" ]; then
            echo "MinIO API: http://localhost:${minio_api}"
        fi
        if [ -n "$minio_console" ]; then
            echo "MinIO Console: http://localhost:${minio_console}"
        fi
        echo ""
        
        # Show container info
        docker ps --filter name=${CONTAINER_NAME} --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"
        echo ""
        
        # Show service status inside container
        log_info "Service status:"
        docker exec ${CONTAINER_NAME} supervisorctl status 2>/dev/null || log_warning "Could not get service status"
        
    else
        log_warning "Container exists but is not running"
        echo "Run: ./neuroinsight-autohs-docker start"
    fi
}

# Health check
cmd_health() {
    check_docker
    
    if ! container_running; then
        log_error "Container is not running"
        return 1
    fi
    
    echo "Running health check..."
    docker exec ${CONTAINER_NAME} /app/healthcheck.sh
}

# View logs
cmd_logs() {
    check_docker
    
    if ! container_running; then
        log_error "Container is not running"
        return 1
    fi
    
    local service="${1:-all}"
    
    case $service in
        backend|worker|beat|monitor|postgresql|redis|minio)
            log_info "Showing $service logs (Ctrl+C to exit)..."
            docker exec ${CONTAINER_NAME} tail -f /var/log/supervisor/${service}.log 2>/dev/null || \
            docker exec ${CONTAINER_NAME} tail -f /var/log/supervisor/${service}_err.log
            ;;
        container)
            log_info "Showing container logs (Ctrl+C to exit)..."
            docker logs -f ${CONTAINER_NAME}
            ;;
        all|*)
            log_info "Showing all logs (Ctrl+C to exit)..."
            docker logs -f ${CONTAINER_NAME}
            ;;
    esac
}

# Install/run container
cmd_install() {
    local assume_yes=false
    if [ "${1:-}" = "-y" ] || [ "${NEUROINSIGHT_INSTALL_YES:-}" = "1" ]; then
        assume_yes=true
    fi

    preflight_install

    if container_exists; then
        if [ "$assume_yes" = true ]; then
            cmd_remove
        else
            log_warning "Container already exists"
            read -p "Remove and recreate? (y/n): " confirm
            if [ "$confirm" != "y" ]; then
                log_info "Keeping existing container — run: ./neuroinsight-autohs-docker start"
                exit 0
            fi
            cmd_remove
        fi
    fi

    log_info "Installing NeuroInsight-AutoHS (Docker all-in-one)..."
    pull_required_images

    # Find available port for web interface
    log_info "Finding available port for web interface (range: 8000-8050)..."
    local port
    port=$(find_available_port)

    if [ -z "$port" ]; then
        log_error "No available ports found in range 8000-8050"
        log_error "Please stop other services or free up a port in this range"
        exit 1
    fi

    log_success "Selected web port: $port"

    # Find available port for MinIO API
    log_info "Finding available port for MinIO API (range: 9000-9050)..."
    local minio_api_port
    minio_api_port=$(find_available_port_in_range 9000 9050)

    if [ -z "$minio_api_port" ]; then
        log_error "No available ports found in range 9000-9050 for MinIO API"
        exit 1
    fi

    log_success "Selected MinIO API port: $minio_api_port"

    # Find available port for MinIO Console (exclude API port)
    log_info "Finding available port for MinIO Console (range: 9000-9050)..."
    local minio_console_port
    minio_console_port=$(find_available_port_in_range 9000 9050 "$minio_api_port")

    if [ -z "$minio_console_port" ]; then
        log_error "No available ports found in range 9000-9050 for MinIO Console"
        exit 1
    fi

    log_success "Selected MinIO Console port: $minio_console_port"

    local license_mount="" license_path=""
    license_path="$(find_license_path)"
    license_mount="-v ${license_path}:/app/license.txt:ro"
    log_success "License found and will be mounted: $license_path"

    local platform_args entrypoint_mount
    platform_args="$(docker_platform_args)"
    entrypoint_mount="$(entrypoint_mount_args)"

    log_info "Creating container..."
    log_info "  Web Interface: http://localhost:${port}"
    log_info "  MinIO API: http://localhost:${minio_api_port}"
    log_info "  MinIO Console: http://localhost:${minio_console_port}"
    log_info "Docker socket, platform, and entrypoint are configured automatically"

    # shellcheck disable=SC2086
    docker run -d \
        --name "${CONTAINER_NAME}" \
        -p "${port}:8000" \
        -p "${minio_api_port}:9000" \
        -p "${minio_console_port}:9001" \
        -v /var/run/docker.sock:/var/run/docker.sock \
        -v "${VOLUME_NAME}:/data" \
        ${license_mount} \
        ${entrypoint_mount} \
        ${platform_args} \
        --restart unless-stopped \
        "${IMAGE_NAME}"

    log_success "Container created"
    wait_for_web_ready "$port" || true

    cmd_status
    echo ""
    log_success "NeuroInsight-AutoHS is ready!"
    echo ""
    echo "Web Interface: http://localhost:${port}"
    echo "MinIO API: http://localhost:${minio_api_port}"
    echo "MinIO Console: http://localhost:${minio_console_port}"
    echo ""
    log_info "Upload a T1 NIfTI scan in the Jobs page to start processing."
}

# First-time setup: install with defaults (non-interactive)
cmd_setup() {
    NEUROINSIGHT_INSTALL_YES=1 cmd_install -y
}

# Check prerequisites without installing
cmd_check() {
    echo "======================================"
    echo "NeuroInsight-AutoHS setup check"
    echo "======================================"
    preflight_install --verbose
    echo ""
    log_success "All requirements met — run: ./neuroinsight-autohs-docker setup"
}

# Remove container
cmd_remove() {
    check_docker
    
    if container_running; then
        log_info "Stopping container..."
        docker stop ${CONTAINER_NAME}
    fi
    
    if container_exists; then
        log_info "Removing container..."
        docker rm ${CONTAINER_NAME}
        log_success "Container removed"
    else
        log_warning "Container does not exist"
    fi
}

# Clean data
cmd_clean() {
    check_docker
    
    local days=30
    
    # Parse --days option
    while [[ $# -gt 0 ]]; do
        case $1 in
            --days)
                days="$2"
                shift 2
                ;;
            *)
                shift
                ;;
        esac
    done
    
    log_warning "This will clean up jobs older than ${days} days"
    read -p "Continue? (y/n): " confirm
    if [ "$confirm" != "y" ]; then
        exit 0
    fi
    
    if container_running; then
        log_info "Running cleanup (retaining last ${days} days)..."
        docker exec ${CONTAINER_NAME} bash -c "
            export DATABASE_URL='postgresql://neuroinsight_autohs:neuroinsight_autohs_secure_password@localhost:5432/neuroinsight_autohs'
            cd /app && PYTHONPATH=/app python3 scripts/clean.py --days ${days}
        "
        log_success "Cleanup completed"
    else
        log_error "Container is not running"
    fi
}

# Delete specific job
cmd_delete() {
    check_docker
    
    local job_id="$1"
    local force="${2}"
    
    if [ -z "$job_id" ]; then
        log_error "Please specify job ID"
        echo "Usage: ./neuroinsight-autohs-docker delete <job_id> [--force]"
        echo ""
        echo "Example: ./neuroinsight-autohs-docker delete d1a2c36e"
        echo "         ./neuroinsight-autohs-docker delete d1a2c36e --force"
        exit 1
    fi
    
    if ! container_running; then
        log_error "Container is not running"
        return 1
    fi
    
    log_info "Deleting job: ${job_id}"
    
    # Build command with optional force flag
    local cmd="cd /app && PYTHONPATH=/app python3 scripts/delete_job.py ${job_id}"
    if [ "$force" = "--force" ] || [ "$force" = "-f" ]; then
        cmd="${cmd} --force"
    fi
    
    docker exec -it ${CONTAINER_NAME} bash -c "$cmd"
}

# Bring/recover job
cmd_bring() {
    check_docker
    
    local job_id="$1"
    
    if [ -z "$job_id" ]; then
        log_error "Please specify job ID"
        echo "Usage: ./neuroinsight-autohs-docker bring <job_id>"
        echo ""
        echo "Example: ./neuroinsight-autohs-docker bring abc12345"
        exit 1
    fi
    
    if ! container_running; then
        log_error "Container is not running"
        return 1
    fi
    
    log_info "Recovering job: ${job_id}"
    docker exec ${CONTAINER_NAME} bash -c "cd /app && PYTHONPATH=/app python3 scripts/bring_job.py ${job_id}"
}

# Access shell
cmd_shell() {
    check_docker
    
    if ! container_running; then
        log_error "Container is not running"
        return 1
    fi
    
    local user="${1:-neuroinsight-autohs}"
    log_info "Opening shell as $user (type 'exit' to quit)..."
    docker exec -it -u ${user} ${CONTAINER_NAME} bash
}

# Update image
cmd_update() {
    check_docker

    log_info "Pulling latest images..."
    pull_required_images

    log_info "Recreating container with new image..."
    cmd_remove
    NEUROINSIGHT_INSTALL_YES=1 cmd_install -y
}

# Backup data
cmd_backup() {
    check_docker
    
    local backup_file="neuroinsight-backup-$(date +%Y%m%d-%H%M%S).tar.gz"
    
    log_info "Creating backup..."
    docker run --rm \
        -v ${VOLUME_NAME}:/data \
        -v $(pwd):/backup \
        alpine tar czf /backup/${backup_file} /data
    
    log_success "Backup created: ${backup_file}"
}

# Restore data
cmd_restore() {
    check_docker
    
    local backup_file="$1"
    
    if [ -z "$backup_file" ]; then
        log_error "Please specify backup file"
        echo "Usage: ./neuroinsight-autohs-docker restore <backup-file>"
        exit 1
    fi
    
    if [ ! -f "$backup_file" ]; then
        log_error "Backup file not found: $backup_file"
        exit 1
    fi
    
    log_warning "This will replace all current data"
    read -p "Continue? (y/n): " confirm
    if [ "$confirm" != "y" ]; then
        exit 0
    fi
    
    log_info "Restoring from backup..."
    docker run --rm \
        -v ${VOLUME_NAME}:/data \
        -v $(pwd):/backup \
        alpine sh -c "rm -rf /data/* && tar xzf /backup/${backup_file}"
    
    log_success "Restore completed"
    log_info "Restart container: ./neuroinsight-autohs-docker restart"
}

# Check license status
cmd_license() {
    echo "======================================"
    echo "FreeSurfer License Check"
    echo "======================================"
    echo ""
    
    # Check if container is running
    if container_running; then
        log_info "Checking license in container..."
        if docker exec ${CONTAINER_NAME} test -f /app/license.txt; then
            log_success "License file found in container"
            
            # Check if it's example content
            if docker exec ${CONTAINER_NAME} grep -q "REPLACE THIS EXAMPLE CONTENT" /app/license.txt 2>/dev/null || \
               docker exec ${CONTAINER_NAME} grep -q "FreeSurfer License File - EXAMPLE" /app/license.txt 2>/dev/null; then
                log_warning "License appears to be example content"
                echo ""
                echo "Please replace with a real FreeSurfer license:"
                echo "  1. Visit: https://surfer.nmr.mgh.harvard.edu/registration.html"
                echo "  2. Register (free for research)"
                echo "  3. Save license as license.txt in this directory"
                echo "  4. Restart: ./neuroinsight-autohs-docker restart"
            else
                # Show first line (email)
                local first_line=$(docker exec ${CONTAINER_NAME} head -n1 /app/license.txt)
                log_success "Valid license detected"
                echo "  Email: $first_line"
                echo ""
                log_success "FreeSurfer processing is enabled!"
            fi
        else
            log_warning "No license file found in container"
            echo ""
            echo "Application is running in demo mode (mock processing)"
            echo ""
            echo "To enable full FreeSurfer processing:"
            echo "  1. Get license: https://surfer.nmr.mgh.harvard.edu/registration.html"
            echo "  2. Save as license.txt in this directory"
            echo "  3. Restart: ./neuroinsight-autohs-docker restart"
        fi
    else
        # Check on host system
        log_info "Checking for license files on host..."
        echo ""

        if license_path="$(find_license_path)"; then
            log_success "Found: $license_path"
            if license_is_example "$license_path"; then
                log_warning "License appears to be example content — replace before processing"
                echo ""
                print_license_help "is invalid"
            else
                log_success "Valid license file on host (mounted on install)"
                echo ""
                echo "Run setup if the container is not installed yet:"
                echo "  ./neuroinsight-autohs-docker setup"
            fi
        else
            log_warning "No license file found"
            echo ""
            print_license_help "not found"
        fi
    fi
}

