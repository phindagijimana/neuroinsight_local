For Docker Compose: docker-compose up -d

EOF
}

# Main command dispatcher
case "${1:-help}" in
    setup)
        cmd_setup
        ;;
    check)
        cmd_check
        ;;
    install)
        shift
        cmd_install "$@"
        ;;
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    restart)
        cmd_restart
        ;;
    status)
        cmd_status
        ;;
    health)
        cmd_health
        ;;
    logs)
        cmd_logs "$2"
        ;;
    shell)
        cmd_shell "$2"
        ;;
    clean)
        shift
        cmd_clean "$@"
        ;;
    delete)
        cmd_delete "$2" "$3"
        ;;
    bring)
        cmd_bring "$2"
        ;;
    remove|uninstall)
        cmd_remove
        ;;
    update)
        cmd_update
        ;;
    backup)
        cmd_backup
        ;;
    restore)
        cmd_restore "$2"
        ;;
    license)
        cmd_license
        ;;
    help|--help|-h)
        cmd_help
        ;;
    *)
        log_error "Unknown command: $1"
        echo ""
        cmd_help
        exit 1
        ;;
esac
